BOT_TOKEN=8985052205:AAGy9KcTj661rtxdqPoticbOsUYydoNUYx4
BOT_USERNAME=Napoleonrobert_bot
BOT_DISPLAY_NAME=Napoleon_bot

# ─── مظهر البوت ─────────────────────────────────────────────
# تأثير حركي عند فتح القائمة (اجعلها false إذا صار البوت بطيء)
UI_ANIMATIONS=true
# بانر متحرك أعلى القوائم: file_id أو رابط https لملف GIF/MP4
# للحصول على file_id: أرسل الـ GIF للبوت من حساب الإدمن وسيرد عليك به
MENU_BANNER=
# بانر خاص بشاشة الموافقة (يستخدم MENU_BANNER إذا تُرك فارغاً)
CONSENT_BANNER=

# معرف تليجرام للإدمن (من @userinfobot) — مفصول بفاصلة لأكثر من واحد
ADMIN_IDS=841981842

# روابط التواصل والاشتراك الإلزامي
FACEBOOK_URL=https://www.facebook.com/share/1EPqQiSMun/
TELEGRAM_CHANNEL_URL=https://t.me/ESRteam
# يجب أن يكون البوت مشرفاً في القناة حتى يعمل التحقق
REQUIRED_CHANNEL_ID=@ESRteam
# بديل رقمي (اختياري): REQUIRED_CHANNEL_ID=-1004494629525
REQUIRE_CHANNEL_SUBSCRIPTION=false
# true = يمنع الدخول إذا فشل التحقق (البوت مو مشرف)
# false = يسمح بالمرور مؤقتاً لحد ما تضيف البوت مشرف
SUBSCRIPTION_STRICT_MODE=true
TELEGRAM_SUPPORT_URL=https://t.me/NapoleonSupport

# ─── قاعدة البيانات (محلية على VPS — SQLite) ───────────────
# الملف يُحفظ داخل مجلد المشروع: data/telegram_bot.db
# لا تحتاج MySQL — كل البيانات على السيرفر نفسه
DATABASE_URL=sqlite:///data/telegram_bot.db

# مسار مطلق (اختياري — إذا بدك تحدد مكان الملف بنفسك):
# DATABASE_URL=sqlite:////root/home/alipride/bot_ich/data/telegram_bot.db

# MySQL — لا تستخدمه إلا إذا بدك قاعدة خارجية:
# DATABASE_URL=mysql+pymysql://user:password@localhost/ichancy_bot

